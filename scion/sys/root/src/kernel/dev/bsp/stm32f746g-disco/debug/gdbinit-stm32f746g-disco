#   terminal 1 : openocd -f sys/root/src/kernel/dev/bsp/stm32f746g-disco/debug/openocd-stm32f746g-disco.cfg
#   terminal 2 : gdb-multiarch -x sys/root/src/kernel/dev/bsp/stm32f746g-disco/debug/gdbinit-stm32f746g-disco $LEPTON_BUILD/stm32f746g-disco-embos/lepton.elf
